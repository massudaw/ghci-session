cabal-version:      2.4
name:               ghci-session
version:            0.2.0.0
synopsis:           A warm GHCi per project: verdicts you can trust, memory that does not grow with every edit
description:
  One package, three parts. @ghci-session-engine@ IS GHCi -- the compiler's own interactive front end,
  vendored -- with a socket where its terminal was and the session's own operations built in (what is loaded,
  fork a server, unlink the CAFs a reload superseded). @ghci-session@ is the command and the small daemon that
  owns one engine per session: reload on save, checks, STALE-aware verdicts, composed sessions, servers, orphan
  collection. The LIBRARY is for a project's own code: "GHC.Hygiene.Census" says what is holding the heap,
  "GHC.Hygiene.Zygote" hands a server's state to its replacement. See README.md.
license:            MIT
license-files:      LICENSE vendor/ghc-9.14.1/LICENSE vendor/ghc-9.10.3/LICENSE vendor/ghc-9.6.7/LICENSE
author:             Wesley Massuda
maintainer:         wesley.massuda@gmail.com
homepage:           https://github.com/massudaw/ghci-session
category:           Development
-- Custom, not Simple: cabal does not recompile C when a header or the C options (the fff flag) change; Setup.hs does
build-type:         Custom
extra-source-files: README.md cbits/*.h hygiene/c/rts_syms.h hygiene/c/caf_common.h hygiene/c/caf_modules.h

custom-setup
  setup-depends:    base >=4 && <5, Cabal >=3.10, bytestring, directory, filepath

-- libfff (https://github.com/dmtrKovalenko/fff), a file finder for `grep` / `find`. Off by default: search is a
-- plain scan, and nothing is fetched. On (-f+fff, or GHS_FFF=1 ./build.sh, which fetches the library): the C that
-- loads it at run time is built, and search uses it when it is there to load (a scan otherwise).
flag fff
  description: search with libfff when it can be loaded (cbits/ghs_fff.c)
  default:     False
  manual:      True

-- The command and the daemon, as a library: so a session can LOAD it beside the libraries it uses (the build
-- tool's multi-unit repl takes libraries, not executables), and an edit to any of them is a reload.
library
  hs-source-dirs:   app
  exposed-modules:  GhciSession.Json, GhciSession.Config, GhciSession.Sys, GhciSession.Repl, GhciSession.Watch,
                    GhciSession.Daemon, GhciSession.Gc, GhciSession.Cli, GhciSession.SelfTest, GhciSession.SelfBench,
                    GhciSession.Doc, GhciSession.History, GhciSession.Mcp, GhciSession.Llm, GhciSession.Anthropic, GhciSession.ClaudeCli, GhciSession.Import, GhciSession.ImportStamp, GhciSession.Chat, GhciSession.ChatUi, GhciSession.ChatProfile, GhciSession.ChatTui,
                    GhciSession.Search, GhciSession.Vfs, GhciSession.Usage, GhciSession.Image, GhciSession.Wire, GhciSession.Inbox, GhciSession.Carry, GhciSession.Roll, GhciSession.Quota, GhciSession.QuotaFit, GhciSession.SelfRound, GhciSession.Replay, GhciSession.Know, GhciSession.Md, GhciSession.Top
  c-sources:        cbits/ghs_sys.c, cbits/ghs_http.c
  if flag(fff)
    c-sources:      cbits/ghs_fff.c
    cpp-options:    -DHAVE_FFF
  include-dirs:     cbits
  -- (ghci-hygiene: so a session ON this package -- ghci-session.json here -- has GHC.Hygiene in scope)
  build-depends:    base >=4.18 && <5, bytestring, containers, directory, filepath, process, stm, text, time, unix, ghci-hygiene, ghostty-vt, ghostty-tui
  default-language: Haskell2010
  default-extensions: ScopedTypeVariables
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-unused-imports
  if impl(ghc >= 9.8)
    ghc-options:    -Wno-x-partial

-- The executable: its `main` is C (cbits/ghs_main.c picks the runtime's options per command; cbits/ghs_fast.c is
-- `eval` without the runtime), and exe/Main.hs is what it calls into the library with.
executable ghci-session
  hs-source-dirs:   exe
  main-is:          Main.hs
  c-sources:        cbits/ghs_main.c, cbits/ghs_fast.c
  include-dirs:     cbits
  build-depends:    base >=4.18 && <5, ghci-session
  default-language: Haskell2010
  default-extensions: ScopedTypeVariables
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-unused-imports -threaded -no-hs-main

-- GHCi itself (engine/GhsEngine.hs): the `ghc` executable's interactive front end, vendored unchanged for one
-- compiler (vendor/fetch.sh), so it builds for exactly that version -- and a session needs it. For another
-- GHC: `vendor/fetch.sh X.Y.Z` and a stanza here.
executable ghci-session-engine
  -- (what differs between compilers in the engine's own code is in engine/ghc-X.Y: GhsCompat, and GhsUnits -- one
  --  for every compiler before 9.14, whose GHCi has no interactive units, in engine/ghc-before-9.14)
  if impl(ghc == 9.14.1)
    buildable: True
    hs-source-dirs: engine, engine/ghc-9.14, app, vendor/ghc-9.14.1, vendor/ghc-9.14.1/patched, hygiene/src
    other-modules:  GHC.Driver.Session.Lint, GHC.Driver.Session.Mode, GHCi.UI.Print, GHCi.UI.Exception
  elif impl(ghc == 9.10.3)
    buildable: True
    hs-source-dirs: engine, engine/ghc-9.10, engine/ghc-before-9.14, app, vendor/ghc-9.10.3, vendor/ghc-9.10.3/patched, hygiene/src
    other-modules:  GHCi.UI.Exception
  elif impl(ghc == 9.6.7)
    buildable: True
    hs-source-dirs: engine, engine/ghc-9.6, engine/ghc-before-9.14, app, vendor/ghc-9.6.7, vendor/ghc-9.6.7/patched, hygiene/src
    other-modules:  GHCi.UI.Tags
  else
    buildable: False
  main-is:          Main.hs
  other-modules:    GhsEngine, GhsFastLoad, GhsAddUnits, GhsCompat, GhsUnits, GhcMain, GhciSession.Json
                    GHCi.Leak, GHCi.UI, GHCi.UI.Info, GHCi.UI.Monad, GHCi.Util
  -- the hygiene modules the engine itself runs are compiled INTO it (not the ghci-hygiene package): a session
  -- whose project depends on that package loads its own build of it, and two libraries of one unit name in
  -- one process resolve each other's symbols -- the first `census EXPR` after the split died in stg_ap_pp.
  -- As its own modules they are another unit; the two copies share only the C store, by slot name.
  other-modules:    GHC.Hygiene, GHC.Hygiene.Census, GHC.Hygiene.Store, GHC.Hygiene.Zygote
  -- the hygiene C is part of GHCi here: it reads the RTS this executable runs
  c-sources:        hygiene/c/ghci_cafs.c, hygiene/c/heap_census.c, hygiene/c/heap_dups.c, hygiene/c/loader_stats.c, hygiene/c/store.c, hygiene/c/gc_once.c, hygiene/c/exports.c
  include-dirs:     hygiene/c
  build-depends:    base, array, bytestring, directory, process, filepath, containers, transformers, unix, text,
                    ghc, ghc-boot, ghci, deepseq, ghc-prim, haskeline, exceptions, time
  cpp-options:      -DHAVE_INTERNAL_INTERPRETER
  default-language: GHC2021
  default-extensions: NoImplicitPrelude, ScopedTypeVariables, BangPatterns
  -- as the `ghc` executable is built: dynamically linked (so loaded code goes through the system linker, not
  -- GHC's own object loader), CAFs kept (interpreted code refers to them by address), its RTS flags
  ghc-options:      -threaded -dynamic -fkeep-cafs -rtsopts=all "-with-rtsopts=-K512M -H -I5 -T"
  -- code loaded into the engine finds the hygiene C by name (dlsym: the census, the store that outlives a
  -- reload, the major GC, the duplicate finder). macOS lets dlsym see an executable's own symbols; Linux only
  -- those the link exports, which was none -- every one of them answered "not the engine". Only these.
  if os(linux)
    ld-options:     -Wl,--export-dynamic-symbol=ghs_*
