cabal-version:      2.4
name:               ghci-session
version:            0.2.0.0
synopsis:           A warm GHCi per project: verdicts you can trust, memory that does not grow with every edit
description:
  One package, two halves. The EXECUTABLE (@ghci-session@) keeps a @cabal repl@ warm behind a small daemon:
  reload on save, checks, STALE-aware verdicts, composed sessions, servers forked from the repl, orphan
  collection. The LIBRARY is what your project links to use the rest: "GHC.Hygiene" unlinks the CAFs a
  @:reload@ supersedes (GHCi never frees them), "GHC.Hygiene.Census" says what is holding the heap, and
  "GHC.Hygiene.Zygote" forks a server out of the session. See README.md.
license:            MIT
build-type:         Simple
extra-source-files: README.md
data-files:         hygiene/build.sh hygiene/c/*.c bin/ghci-rts.sh bin/ghci-engine.sh

library
  hs-source-dirs:   hygiene/src
  exposed-modules:  GHC.Hygiene, GHC.Hygiene.Census, GHC.Hygiene.Zygote
  build-depends:    base >=4.18 && <5, bytestring, containers, directory, text, unix
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-type-defaults

executable ghci-session
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    GhciSession.Json, GhciSession.Config, GhciSession.Sys, GhciSession.Repl, GhciSession.Watch,
                    GhciSession.Daemon, GhciSession.Gc, GhciSession.Cli, GhciSession.SelfTest, GhciSession.SelfBench, Paths_ghci_session
  autogen-modules:  Paths_ghci_session
  c-sources:        cbits/ghs_sys.c, cbits/ghs_main.c
  -- (the library: so a session ON this package -- ghci-session.json here -- has GHC.Hygiene in scope)
  build-depends:    base >=4.18 && <5, bytestring, containers, directory, filepath, process, stm, text, time, unix, ghci-session
  default-language: Haskell2010
  default-extensions: ScopedTypeVariables
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-x-partial -Wno-unused-imports -threaded -no-hs-main

-- GHCi itself, with a socket where its terminal was (engine/GhsEngine.hs): the `ghc` executable's interactive
-- front end, vendored unchanged for this compiler (vendor/fetch.sh), so it builds for exactly that version.
-- With another GHC the package still builds, and sessions drive the stock GHCi through a terminal.
executable ghci-session-engine
  if impl(ghc == 9.14.1)
    buildable: True
    hs-source-dirs: engine, vendor/ghc-9.14.1, vendor/ghc-9.14.1/patched
  else
    buildable: False
  main-is:          Main.hs
  other-modules:    GhsEngine, GhcMain, GHC.Driver.Session.Lint, GHC.Driver.Session.Mode
                    GHCi.Leak, GHCi.UI, GHCi.UI.Info, GHCi.UI.Monad, GHCi.UI.Print, GHCi.UI.Exception, GHCi.Util
  c-sources:        cbits/ghs_sys.c
  build-depends:    base, array, bytestring, directory, process, filepath, containers, transformers, unix,
                    ghc, ghc-boot, ghci, deepseq, ghc-prim, haskeline, exceptions, time
  cpp-options:      -DHAVE_INTERNAL_INTERPRETER
  default-language: GHC2021
  default-extensions: NoImplicitPrelude, ScopedTypeVariables, BangPatterns
  -- as the `ghc` executable is built: dynamically linked (so loaded code goes through the system linker, not
  -- GHC's own object loader), CAFs kept (interpreted code refers to them by address), its RTS flags
  ghc-options:      -threaded -dynamic -fkeep-cafs -rtsopts=all "-with-rtsopts=-K512M -H -I5 -T"
