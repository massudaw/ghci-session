cabal-version:      2.4
name:               ghci-session
version:            0.2.0.0
synopsis:           A warm GHCi per project: verdicts you can trust, memory that does not grow with every edit
description:
  One package, three parts. @ghci-session-engine@ IS GHCi -- the compiler's own interactive front end,
  vendored -- with a socket where its terminal was and the session's own operations built in (what is loaded,
  fork a server, unlink the CAFs a reload superseded). @ghci-session@ is the command and the small daemon that
  owns one engine per session: reload on save, checks, STALE-aware verdicts, composed sessions, servers, orphan
  collection. The LIBRARY is for a project's own code: "GHC.Hygiene.Census" says what is holding the heap,
  "GHC.Hygiene.Zygote" hands a server's state to its replacement. See README.md.
license:            MIT
license-files:      LICENSE vendor/ghc-9.14.1/LICENSE
author:             Wesley Massuda
maintainer:         wesley.massuda@gmail.com
homepage:           https://github.com/massudaw/ghci-session
category:           Development
build-type:         Simple
extra-source-files: README.md hygiene/c/rts_syms.h

library
  hs-source-dirs:   hygiene/src
  exposed-modules:  GHC.Hygiene, GHC.Hygiene.Census, GHC.Hygiene.Zygote
  build-depends:    base >=4.18 && <5, bytestring, containers, directory, text, unix
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-type-defaults

executable ghci-session
  hs-source-dirs:   app
  main-is:          Main.hs
  other-modules:    GhciSession.Json, GhciSession.Config, GhciSession.Sys, GhciSession.Repl, GhciSession.Watch,
                    GhciSession.Daemon, GhciSession.Gc, GhciSession.Cli, GhciSession.SelfTest, GhciSession.SelfBench,
                    GhciSession.Doc
  c-sources:        cbits/ghs_sys.c, cbits/ghs_main.c, cbits/ghs_fast.c
  -- (the library: so a session ON this package -- ghci-session.json here -- has GHC.Hygiene in scope)
  build-depends:    base >=4.18 && <5, bytestring, containers, directory, filepath, process, stm, text, time, unix, ghci-session
  default-language: Haskell2010
  default-extensions: ScopedTypeVariables
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-x-partial -Wno-unused-imports -threaded -no-hs-main

-- GHCi itself (engine/GhsEngine.hs): the `ghc` executable's interactive front end, vendored unchanged for one
-- compiler (vendor/fetch.sh), so it builds for exactly that version -- and a session needs it. For another
-- GHC: `vendor/fetch.sh X.Y.Z` and a stanza here.
executable ghci-session-engine
  if impl(ghc == 9.14.1)
    buildable: True
    hs-source-dirs: engine, app, vendor/ghc-9.14.1, vendor/ghc-9.14.1/patched
  else
    buildable: False
  main-is:          Main.hs
  other-modules:    GhsEngine, GhcMain, GhciSession.Json, GHC.Driver.Session.Lint, GHC.Driver.Session.Mode
                    GHCi.Leak, GHCi.UI, GHCi.UI.Info, GHCi.UI.Monad, GHCi.UI.Print, GHCi.UI.Exception, GHCi.Util
  -- the hygiene C is part of GHCi here: it reads the RTS this executable runs
  c-sources:        hygiene/c/ghci_cafs.c, hygiene/c/heap_census.c, hygiene/c/loader_stats.c, hygiene/c/exports.c
  include-dirs:     hygiene/c
  build-depends:    base, array, bytestring, directory, process, filepath, containers, transformers, unix, text,
                    ghc, ghc-boot, ghci, deepseq, ghc-prim, haskeline, exceptions, time, ghci-session
  cpp-options:      -DHAVE_INTERNAL_INTERPRETER
  default-language: GHC2021
  default-extensions: NoImplicitPrelude, ScopedTypeVariables, BangPatterns
  -- as the `ghc` executable is built: dynamically linked (so loaded code goes through the system linker, not
  -- GHC's own object loader), CAFs kept (interpreted code refers to them by address), its RTS flags
  ghc-options:      -threaded -dynamic -fkeep-cafs -rtsopts=all "-with-rtsopts=-K512M -H -I5 -T"
