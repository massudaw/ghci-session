cabal-version:      2.4
name:               ghci-hygiene
version:            0.1.0.0
synopsis:           Free what a GHCi :reload leaves behind, and census the heap of a GHCi session
description:
  A dynamically linked GHCi never unloads a superseded module and the RTS keeps every CAF of every old
  temporary library as a GC root, so a long editing session leaks one copy of every CAF per reload.
  'GHC.Hygiene.pruneCafs' unlinks the superseded ones; 'GHC.Hygiene.Census' says what is holding memory.
  Both call small C libraries built by hygiene/build.sh against the running GHC's RTS (macOS arm64/x86_64;
  elsewhere they report "no library" and do nothing).
license:            MIT
build-type:         Simple
extra-source-files: c/*.c build.sh

library
  hs-source-dirs:   src
  exposed-modules:  GHC.Hygiene, GHC.Hygiene.Census
  build-depends:    base >=4.18 && <5, containers, directory, text, unix
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-do-bind -Wno-type-defaults
