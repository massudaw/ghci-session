{
  "default": "tool",
  "hygiene": true,
  "summarize_cmd": "/Users/wesleymassuda/code/claude-sdk-bridge/bin/ghci-claude-summarize",
  "summarize_jobs": 8,
  "targets": {
    "tool": {
      "units": [
        "lib:ghci-session",
        "lib:ghostty-tui",
        "lib:ghostty-vt",
        "lib:ghci-hygiene"
      ],
      "watch": [
        "app",
        "cbits",
        "hygiene/src",
        "tui/src",
        "tui/cbits",
        "ghostty-vt/src",
        "ghostty-vt/cbits",
        "ghostty-vt/include"
      ],
      "modules": [
        "GhciSession.SelfTest",
        "GhciSession.SelfBench"
      ],
      "test": {
        "expr": "GhciSession.SelfTest.run",
        "pass": "^selftest: all ",
        "fail": "^\\[FAIL\\]|FAILED$"
      }
    },
    "engine": {
      "units": [
        "exe:ghci-session-engine"
      ],
      "watch": [
        "engine",
        "hygiene/c",
        "hygiene/src"
      ]
    }
  }
}
